FIREBASE_PROJECT_ID=eva-ai-made-for-women
FIREBASE_WEB_API_KEY=AIza...            # gcloud services api-keys get-key-string <uid>
JWT_SECRET=change-me                    # openssl rand -hex 32
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/eva-api-dev.json   # local dev only

# Transactional email (issue #6): activation and password-reset links.
# `log` prints every link to stdout instead of sending it — local only, refused under
# NODE_ENV=production. `postmark` sends through Postmark and needs the server token.
EMAIL_TRANSPORT=log                     # log | postmark
# POSTMARK_API_KEY=change-me            # required when EMAIL_TRANSPORT=postmark
POSTMARK_FROM=hello@evatracker.com
PUBLIC_WEB_URL=https://evatracker.com   # links point at /activate and /reset here

# Auth throttling (issue #5). All optional — the defaults below are what the code uses
# if unset. Set any *limit* to 0 to disable that dimension, e.g. while working locally.
# Three of them are not simple per-dimension switches and say so in their own notes.
# RATE_LIMIT_WINDOW_SECONDS=900           # the window for EVERY per-IP counter, and the backoff's cap and decay. Minimum 1:
#                                         # 0 is refused at boot because it would remove throttling across /auth/* and
#                                         # /me/auth/providers rather than disable one named dimension.
# RATE_LIMIT_SIGNIN_PER_IP=60
# RATE_LIMIT_SIGNIN_PER_EMAIL=10           # since #37: free attempts before the FIRST block, not attempts per window
# RATE_LIMIT_SIGNUP_PER_IP=30
# RATE_LIMIT_SIGNUP_PER_EMAIL=5            # likewise
# RATE_LIMIT_BACKOFF_BASE_SECONDS=30       # first block after a per-address allowance runs out; doubles, capped at the window.
#                                          # 0 does NOT fall back to a fixed window — it disables the whole per-address
#                                          # dimension for sign-in and sign-up, which is the only defence against a
#                                          # distributed attack on one account. Local development only.
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1          # 1 = direct Cloud Run. 2 once an external load balancer is put in front — and only
#                                          # together with --ingress=internal-and-cloud-load-balancing, or requests sent
#                                          # straight to the run.app URL skip per-IP throttling entirely. Minimum 1: 0 is
#                                          # refused at boot, because it would strip per-IP limiting from every route.
# RATE_LIMIT_RESEND_PER_EMAIL_SECONDS=60   # resend / forgot: one per address per window
# RATE_LIMIT_RESEND_PER_IP=30              # per-IP backstop over RATE_LIMIT_WINDOW_SECONDS
# RATE_LIMIT_TOKEN_PER_IP=60               # /auth/activate, /auth/password/reset: per IP
# RATE_LIMIT_IDP_PER_IP=60                 # /auth/idp, /me/auth/providers: per IP

# Sign in with Apple and Google (issue #7). All optional: unset means that provider's
# capability is unavailable (503), not that the API refuses to boot. Provisioning steps
# and where each value comes from: docs/PROVIDER-SIGNIN.md.
# GOOGLE_IOS_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com  # public; no secret
# APPLE_CLIENT_ID=com.evaapp.ios            # revocation only; the App ID, not the Services ID
# APPLE_TEAM_ID=ABCDE12345                   # revocation only
# APPLE_KEY_ID=ABCDE12345                    # revocation only
# APPLE_SIGNIN_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # Secret Manager

# The Today card's pattern rung (issue #98; the numbers are #26's, via A32). All three or
# none — a partial group is refused at boot. There is deliberately NO default: until a
# reviewer settles the thresholds, GET /me/today answers 503 rather than running a clinical
# heuristic nobody signed. The zeros below are placeholders showing the shape, and `0` is
# refused at boot on purpose: uncommenting these without choosing the numbers fails loudly
# instead of quietly running a rule that never matches.
DASHBOARD_PATTERN_LOW_SIGNAL_DAYS=3          # A32: consecutive logged days carrying a low rating.
                                             # Three, because the card says "last 3 days" and
                                             # "three consecutive days" — the copy is the dose.
                                             # Above 14 is refused (#178): past it the card's
                                             # "consecutive days" / "the last few days" is false.
DASHBOARD_PATTERN_LOW_AT_OR_BELOW=2          # the rating at or below which one is "low": 1–4.
                                             # Two, on the validated 1–5 scale: 3 is the midpoint,
                                             # so "low" is the bottom two. Above 4 is refused —
                                             # at 5 every answered rating is low (#178).
#                                            # Ratings run 1–5, so 5 is refused at boot — it
#                                            # would call every answered rating low.
DASHBOARD_PATTERN_SEVERE_SYMPTOM_DAYS=3      # consecutive days with the SAME symptom severe.
                                             # Above 14 is refused (#178): same bound as
                                             # LOW_SIGNAL_DAYS, for the same reason.
                                             # Dosed but NOT selectable: #175 removed this arm from
                                             # `matchesPattern` because no `symptom_pattern` card
                                             # exists for it to choose, so a severe-symptom run was
                                             # being shown a card about low mood. The group is
                                             # all-or-nothing, so it needs a valid value; nothing
                                             # reads it. It becomes live with the card, not before.
#                                            # Validated but not selectable yet: content/ has
#                                            # no card for that arm, so such a run falls
#                                            # through rather than naming the mood pattern.

# The cycle maths (C11, issue #176). All fifteen or none — a partial group is refused at
# boot, and an out-of-range value is refused with the valid range named. Unset means the
# maths refuses to answer and GET /me/today is 503, the same state an unconfigured pattern
# rung leaves it in; there is no default in the code, because a fallback copy of these
# numbers would be a clinical constant no deployment records having chosen.
#
# These are NOT placeholders. They are the values PRD §Predictions in Cycle mode settled on
# 2026-08-30 (A25-A27), with their sources, plus the period gap #186 decided on 2026-09-16,
# and nothing here is a secret. Copy this file to api/.env and the maths runs on the
# reviewed configuration.
CYCLE_MIN_LENGTH_DAYS=21                 # A25: shorter than this is "unusual length"…
CYCLE_MAX_LENGTH_DAYS=45                 # …and so is longer than this. Excluded, never dropped.
CYCLE_MIN_PERIOD_GAP_DAYS=2              # #186: this many days in a row with nothing logged end a period;
                                         # one fewer is a missed day inside it. Grouping, not a clinical claim.
CYCLE_HISTORY_CYCLES=6                  # A26: the median and the variation span this many counted cycles
CYCLE_MIN_CYCLES_FOR_ESTIMATE=3          # A26: no prediction and no fertile window below this
CYCLE_NARROW_BAND_MIN_CYCLES=6           # A27: wide band at 3-5 counted cycles, tighter at 6+
CYCLE_LUTEAL_PHASE_DAYS=14               # A26: ovulation = next period - this. Wilcox BMJ 2000;321:1259 —
                                         # a calendar convention, not a measurement.
CYCLE_FERTILE_DAYS_BEFORE_OVULATION=5    # A26: the window opens ovulation - 5…
CYCLE_FERTILE_DAYS_AFTER_OVULATION=1     # …and closes ovulation + 1
CYCLE_PEAK_DAYS_BEFORE_OVULATION=2       # A26: peak = the two days before ovulation, through ovulation day
# The FIGO irregularity bands (A25). Source: FIGO AUB System 1 — Munro MG et al.,
# Int J Gynecol Obstet 2018;143:393-408. Shortest-to-longest variation OVER the band's days
# is irregular, and irregular means no prediction and no window at all. An unknown age takes
# the tightest of the three, which is the suppressing direction.
CYCLE_IRREGULAR_YOUNG_MAX_AGE=25         # the 18-25 band ends here
CYCLE_IRREGULAR_MID_MAX_AGE=41           # the 26-41 band ends here; 42+ is the third
CYCLE_IRREGULAR_YOUNG_VARIATION_DAYS=9   # more than 9 days at 18-25
CYCLE_IRREGULAR_MID_VARIATION_DAYS=7     # more than 7 days at 26-41
CYCLE_IRREGULAR_OLDER_VARIATION_DAYS=9   # more than 9 days at 42 and over

# The nutrition targets engine (S2 of the Nutrition coach, issue #222). All twenty-three or
# none - a partial group is refused at boot naming what is missing, and an out-of-range value
# is refused with the valid range named. Unset means the engine refuses to compute a target
# and whatever route serves one answers 503; there is no default in the code, because a
# fallback copy of these numbers would be a dietary constant no deployment records having
# chosen (#26: "an interim default chosen to unblock a build, never revisited, and shipped").
#
# These are NOT placeholders, and nothing here is a secret. Every value carries its source,
# and every value that is a PRODUCT CHOICE rather than a finding says so - A25's preamble rule
# applied to this group by #26's method. The four product choices are the loss deficit, the
# gain surplus, the build-muscle surplus and the per-plan cap; all four, and their reasoning,
# are recorded in docs/LAUNCH.md for the clinical review that is a release gate.

# Basal metabolic rate - Mifflin-St Jeor, female form:
#   BMR = (PER_KG x kg) + (PER_CM x cm) - (PER_YEAR x age) - OFFSET
# FINDING. Source: Mifflin MD, St Jeor ST, Hill LA, Scott BJ, Daugherty SA, Koh YO. A new
# predictive equation for resting energy expenditure in healthy individuals. Am J Clin Nutr
# 1990;51:241-7. PRD line 771. It is a predictive equation for a population, not a measurement
# of this user - S3's "How this is calculated" sheet says so where the number is shown.
NUTRITION_BMR_PER_KG=10
NUTRITION_BMR_PER_CM=6.25
NUTRITION_BMR_PER_YEAR=5
NUTRITION_BMR_OFFSET=161                 # the female constant; the male form subtracts -5

# Activity factors - total daily energy expenditure = BMR x the band's factor.
# FINDING (the factors), with the band mapping decided in #25 Q4. Source: PRD lines 772-777,
# Mifflin MD et al. 1990 as above. Four bands, not five: "Extremely active" (1.9) is dropped
# because the questionnaire only asks four, so a genuinely very active user is under-fed -
# the safer direction to be wrong here, and still wrong (#25 Q4).
NUTRITION_ACTIVITY_FACTOR_MOSTLY_SITTING=1.2    # PRD's "Sedentary"
NUTRITION_ACTIVITY_FACTOR_LIGHTLY_ACTIVE=1.375  # PRD's "Lightly active"
NUTRITION_ACTIVITY_FACTOR_ACTIVE=1.55           # PRD's "Moderately active"
NUTRITION_ACTIVITY_FACTOR_VERY_ACTIVE=1.725     # PRD's "Very active"

# Goal adjustment applied to total expenditure, as a fraction. Maintain and Eat better take
# no adjustment at all (PRD line 780) - the absence of a dose, so there is no variable here.
NUTRITION_ADJUST_LOSE=-0.15              # PRODUCT CHOICE (A30). Range: PRD line 779, -15 to 20%.
                                         # -15% is the safer end - the smaller deficit, more food.
NUTRITION_ADJUST_GAIN=0.15               # PRODUCT CHOICE (#222). Range: PRD line 781, +10 to 15%.
                                         # The top, for the reason A30 chose -15% over -20%:
                                         # it is the end that feeds more. A woman whose goal
                                         # is to gain is the user for whom erring low is most
                                         # harmful - #25: "under-feeding is its own harm in this
                                         # population" - and at +15% the surplus is still only
                                         # ~250-350 kcal/day. Reasoning recorded in docs/LAUNCH.md.
NUTRITION_ADJUST_BUILD_MUSCLE=0.1        # PRODUCT CHOICE (#222). Range: PRD line 782, +5 to 10%.
                                         # The top, same principle; it is also the conservative end
                                         # of the modest surplus the hypertrophy literature
                                         # describes (Slater GJ et al., Front Nutr 2019;6:131),
                                         # so feeding more here is not an aggressive setting.
                                         # Reasoning recorded in docs/LAUNCH.md.

# Protein, grams per kg of CURRENT body weight. Points are A30's; the ranges are PRD lines
# 788-790, within Phillips SM & Van Loon LJC, J Sports Sci 2011;29(S1):S29-38 and the ISSN
# position stand, Jager R et al., JISSN 2017;14:20.
NUTRITION_PROTEIN_LOSE_G_PER_KG=1.6            # A30, within 1.6-2.0
NUTRITION_PROTEIN_BUILD_MUSCLE_G_PER_KG=1.8    # A30, within 1.6-2.2
NUTRITION_PROTEIN_OTHER_G_PER_KG=1.2           # A30, within 1.2-1.6 - gain, maintain, eat better

# Fat floor, as a fraction of total calories. FINDING, and a HARD FLOOR, not a default:
# PRD line 791 - "Sustained low fat intake is associated with menstrual disruption, and an
# adviser built for women must not produce a plan that causes it." Carbohydrate is the
# remainder (PRD line 792). If protein plus this floor ever overruns the calorie target,
# protein yields and this does not.
NUTRITION_FAT_MIN_FRACTION=0.2

# Fibre, grams per day. FINDING (A30), from the Dietary Guidelines for Americans 2020-2025
# rule of 14 g per 1,000 kcal at ~1,800 kcal. Raised when focus area 1 ("Eat more vegetables
# and fibre") or 11 ("Reduce bloating, improve digestion") is selected - PRD line 793. WHICH
# areas raise it is not configurable: those two numbers are which question she answered, not
# a dose.
NUTRITION_FIBRE_G=25
NUTRITION_FIBRE_RAISED_G=30

# The target-weight guards (PRD line 753, A29), applied before a target is accepted.
NUTRITION_MIN_BMI=18.5                   # FINDING. The WHO underweight threshold - WHO Technical
                                         # Report Series 894 (2000). A29: "18.5 stands". A target
                                         # under it is refused with the lowest supported weight.
NUTRITION_MAX_PLAN_LOSS_FRACTION=0.15    # PRODUCT CHOICE, and A29 says so in those words: "The 15%
                                         # cap is a product choice, not a finding." One plan may not
                                         # target more than 15% below her current weight; reach it,
                                         # then set a new plan.

# The rate and calorie clamps (PRD lines 754-756). Every one of them is a FLOOR on calories:
# when a clamp binds, the timeline extends and the target does not drop (canvas sRate).
NUTRITION_MAX_LOSS_KG_PER_WEEK=0.5       # FINDING as stated: PRD line 754, "approximately 0.5 kg
NUTRITION_MAX_LOSS_FRACTION_PER_WEEK=0.01  # per week, or 1% of body weight per week, whichever is
                                         # lower". The lower of the two is what applies.
NUTRITION_MIN_CALORIE_KCAL=1200          # FINDING as stated: PRD line 756, the absolute floor. The
                                         # other floor is her own BMR (line 755) and needs no
                                         # variable - it is computed above.
NUTRITION_KCAL_PER_KG_BODY_MASS=7700     # A PLANNING CONVENTION, not a measurement, and used for the
                                         # timeline only. Wishnofsky NM, Am J Clin Nutr 1958;6:542-6
                                         # (3,500 kcal per pound). It is known to overstate long-run
                                         # change - Hall KD, Int J Obes 2008;32:573-6 - which is why
                                         # the timeline is shown as an estimate and why this is
                                         # configuration rather than arithmetic in the code.

# CI runs this suite against the Firebase emulators (#67, scripts/ci-api.sh) and sets
# these two itself via `firebase emulators:exec`. Set them by hand only to reproduce a
# CI failure locally; unset means the real project, which is the default everywhere else.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080      # also makes firebase.ts skip ADC
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099  # config.identityToolkitBaseUrl follows this
