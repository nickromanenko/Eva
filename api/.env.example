FIREBASE_PROJECT_ID=eva-ai-made-for-women
FIREBASE_WEB_API_KEY=AIza...            # gcloud services api-keys get-key-string <uid>
JWT_SECRET=change-me                    # openssl rand -hex 32
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/eva-api-dev.json   # local dev only

# Transactional email (issue #6): activation and password-reset links.
# `log` prints every link to stdout instead of sending it — local only, refused under
# NODE_ENV=production. `postmark` sends through Postmark and needs the server token.
EMAIL_TRANSPORT=log                     # log | postmark
# POSTMARK_API_KEY=change-me            # required when EMAIL_TRANSPORT=postmark
POSTMARK_FROM=hello@evatracker.com
PUBLIC_WEB_URL=https://evatracker.com   # links point at /activate and /reset here

# Auth throttling (issue #5). All optional — the defaults below are what the code uses
# if unset. Set any *limit* to 0 to disable that dimension, e.g. while working locally.
# Three of them are not simple per-dimension switches and say so in their own notes.
# RATE_LIMIT_WINDOW_SECONDS=900           # the window for EVERY per-IP counter, and the backoff's cap and decay. Setting it
#                                         # to 0 does not disable one dimension — it removes per-IP throttling from every
#                                         # route that has it (/auth/* and /me/auth/providers), and the per-address backoff
#                                         # from sign-in and sign-up. The one thing left standing is the resend/forgot
#                                         # cooldown, which runs on its own knob below. Local development only.
# RATE_LIMIT_SIGNIN_PER_IP=60
# RATE_LIMIT_SIGNIN_PER_EMAIL=10           # since #37: free attempts before the FIRST block, not attempts per window
# RATE_LIMIT_SIGNUP_PER_IP=30
# RATE_LIMIT_SIGNUP_PER_EMAIL=5            # likewise
# RATE_LIMIT_BACKOFF_BASE_SECONDS=30       # first block after a per-address allowance runs out; doubles, capped at the window.
#                                          # 0 does NOT fall back to a fixed window — it disables the whole per-address
#                                          # dimension for sign-in and sign-up, which is the only defence against a
#                                          # distributed attack on one account. Local development only.
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1          # 1 = direct Cloud Run. 2 once an external load balancer is put in front — and only
#                                          # together with --ingress=internal-and-cloud-load-balancing, or requests sent
#                                          # straight to the run.app URL skip per-IP throttling entirely. Minimum 1: 0 is
#                                          # refused at boot, because it would strip per-IP limiting from every route.
# RATE_LIMIT_RESEND_PER_EMAIL_SECONDS=60   # resend / forgot: one per address per window
# RATE_LIMIT_RESEND_PER_IP=30              # per-IP backstop over RATE_LIMIT_WINDOW_SECONDS
# RATE_LIMIT_TOKEN_PER_IP=60               # /auth/activate, /auth/password/reset: per IP
# RATE_LIMIT_IDP_PER_IP=60                 # /auth/idp, /me/auth/providers: per IP

# Sign in with Apple and Google (issue #7). All optional: unset means that provider's
# capability is unavailable (503), not that the API refuses to boot. Provisioning steps
# and where each value comes from: docs/PROVIDER-SIGNIN.md.
# GOOGLE_IOS_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com  # public; no secret
# APPLE_CLIENT_ID=com.evaapp.ios            # revocation only; the App ID, not the Services ID
# APPLE_TEAM_ID=ABCDE12345                   # revocation only
# APPLE_KEY_ID=ABCDE12345                    # revocation only
# APPLE_SIGNIN_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # Secret Manager

# CI runs this suite against the Firebase emulators (#67, scripts/ci-api.sh) and sets
# these two itself via `firebase emulators:exec`. Set them by hand only to reproduce a
# CI failure locally; unset means the real project, which is the default everywhere else.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080      # also makes firebase.ts skip ADC
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099  # config.identityToolkitBaseUrl follows this
