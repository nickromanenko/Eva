# macOS
.DS_Store

# Node / Bun (api, website)
node_modules/
dist/
*.log

# Env
.env
.env.*
!.env.example

# Xcode / XcodeGen (mobile) — .xcodeproj is generated, never committed
mobile/*.xcodeproj
mobile/DerivedData/
xcuserdata/
*.xcuserstate

# Firebase
.firebase/
firebase-debug.log

# Claude Code session files — but the agent definitions are project intent,
# not session state, so they are tracked.
.claude/*
!.claude/agents/
!.claude/commands/

# Astro generated
.astro/
mobile/build/

# Local service-account keys
.secrets/

# Apple signing keys. Never in the repo (GUARDRAILS 1) — and this rule exists because one
# was: `AuthKey_V6JDCDQQG7.p8` reached `main` in #7, swept in by a blanket `git add -A`
# after PROVIDER-SIGNIN §3 told the operator to run `gcloud secrets create --data-file=`
# with no path, which meant the repo root. The key was revoked; this is so the next one
# cannot repeat it.
*.p8
AuthKey_*.p8
