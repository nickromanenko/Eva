---
// Layout for the pages an email links to (/activate, /reset). Kept apart from
// Layout.astro on purpose: these pages carry a one-time token in the URL, so
// they make no third-party request (no Google Fonts, no analytics), set no
// cookie, are not indexed, and send no referrer. They are also built to the
// current DESIGN.md tokens rather than the landing page's older palette.
//
// Montserrat is named first in the stack but never fetched — it renders where
// it is installed and falls back to the system face elsewhere. Self-hosting
// the face is a separate decision (it adds binary assets to the repo).
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <a class="logo" href="/"><img src="/assets/eva-logo.png" alt="Eva" /></a>
      <section class="card">
        <slot />
      </section>
    </main>
  </body>
</html>

<style is:global>
  /* DESIGN.md §2–§6, transcribed as custom properties so the pages never inline a value. */
  :root {
    --eva-deep-pink: #C95F86;
    --eva-blush: #F9DCE6;
    --eva-bg: #FFF9F6;
    --eva-text: #282126;
    --eva-text-secondary: #6F656B;
    --eva-text-muted: #9A9095;

    --eva-success: #7A9B45;
    --eva-success-tint: rgba(205, 231, 157, .26);
    --eva-success-border: rgba(142, 173, 86, .32);
    --eva-error: #C4645A;
    --eva-error-tint: rgba(196, 100, 90, .08);
    --eva-error-border: rgba(196, 100, 90, .26);
    --eva-error-ink: #A9524A;
    --eva-info: #5A7BA0;
    --eva-info-tint: rgba(90, 123, 160, .09);
    --eva-info-border: rgba(90, 123, 160, .26);

    --eva-space-2: 8px;
    --eva-space-3: 12px;
    --eva-space-4: 16px;
    --eva-space-6: 24px;
    --eva-space-8: 32px;
    --eva-space-10: 40px;
    --eva-radius-control: 17px;
    --eva-radius-text: 14px;
    --eva-radius-card: 24px;
    --eva-control-height: 52px;
    --eva-focus-ring: 3px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    background: var(--eva-bg) linear-gradient(135deg, var(--eva-blush), var(--eva-bg)) fixed;
    font-family: Montserrat, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--eva-text-secondary);
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--eva-space-8);
    padding: var(--eva-space-10) var(--eva-space-4);
  }

  /* The logo asset has an opaque white box; multiply lets the gradient show through it. */
  .logo img { height: 34px; width: auto; display: block; mix-blend-mode: multiply; }

  /* Standard card treatment, DESIGN.md §4. */
  .card {
    width: 100%;
    max-width: 420px;
    padding: var(--eva-space-8) var(--eva-space-6);
    border-radius: var(--eva-radius-card);
    background: linear-gradient(150deg, rgba(255, 255, 255, .66), rgba(255, 255, 255, .36));
    -webkit-backdrop-filter: blur(26px) saturate(1.7);
    backdrop-filter: blur(26px) saturate(1.7);
    border: 1px solid rgba(255, 255, 255, .72);
    box-shadow:
      0 12px 30px -18px rgba(40, 33, 38, .35),
      inset 0 1px 0 rgba(255, 255, 255, .9),
      inset 0 -1px 0 rgba(255, 255, 255, .4);
  }

  /* H1 · screen title, Body, Caption — DESIGN.md §3. */
  h1 { font-size: 28px; line-height: 34px; font-weight: 600; color: var(--eva-text); }
  h1:focus { outline: none; }
  p { font-size: 15px; line-height: 24px; }
  h1 + p, p + p { margin-top: var(--eva-space-3); }
  .caption { color: var(--eva-text-muted); font-size: 12.5px; line-height: 19px; }
  .actions + .caption { margin-top: var(--eva-space-4); }

  /* Semantic marks: ✓ circle, ! circle, i circle — the shape carries the state, never the colour alone. */
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin-bottom: var(--eva-space-4);
    border-radius: 50%;
    border: 1px solid;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }
  .mark--success { color: var(--eva-success); background: var(--eva-success-tint); border-color: var(--eva-success-border); }
  .mark--error { color: var(--eva-error); background: var(--eva-error-tint); border-color: var(--eva-error-border); }
  .mark--info { color: var(--eva-info); background: var(--eva-info-tint); border-color: var(--eva-info-border); font-family: Georgia, serif; font-style: italic; }
  .mark--pending { color: var(--eva-text-muted); border-color: rgba(40, 33, 38, .1); }

  .actions { display: flex; flex-direction: column; gap: var(--eva-space-2); margin-top: var(--eva-space-6); }

  /* Primary button — DESIGN.md §5. */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--eva-control-height);
    padding: 0 var(--eva-space-6);
    border: 0;
    border-radius: var(--eva-radius-control);
    background: linear-gradient(180deg, #EE93B1, var(--eva-deep-pink));
    color: #fff;
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 12px 26px -12px rgba(201, 95, 134, .8);
    transition: transform .12s ease, background .12s ease;
  }
  .btn-primary:active { background: linear-gradient(180deg, #D9799C, #B45276); transform: scale(.97); }
  .btn-primary:focus-visible { outline: var(--eva-focus-ring) solid rgba(40, 33, 38, .6); outline-offset: 2px; }
  .btn-primary:disabled { background: rgba(201, 95, 134, .28); box-shadow: none; cursor: default; transform: none; }

  /* Text button — DESIGN.md §5. */
  .btn-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: var(--eva-radius-text);
    background: transparent;
    color: var(--eva-deep-pink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-text:focus-visible { outline: var(--eva-focus-ring) solid rgba(40, 33, 38, .6); outline-offset: 2px; }

  /* Input, label, helper, error — DESIGN.md §3 and §6. */
  .field { display: flex; flex-direction: column; gap: var(--eva-space-2); margin-top: var(--eva-space-4); }
  .field label { font-size: 12px; font-weight: 600; color: var(--eva-text-secondary); }
  .field input {
    height: var(--eva-control-height);
    padding: 0 15px;
    border-radius: var(--eva-radius-control);
    border: 1px solid rgba(40, 33, 38, .1);
    background: rgba(255, 255, 255, .75);
    color: var(--eva-text);
    font: inherit;
    font-size: 15px;
    outline: none;
  }
  .field input:focus { background: #fff; border-color: var(--eva-deep-pink); box-shadow: 0 0 0 var(--eva-focus-ring) rgba(201, 95, 134, .16); }
  .field input[aria-invalid="true"] { background: rgba(255, 255, 255, .8); border-color: var(--eva-error); box-shadow: 0 0 0 var(--eva-focus-ring) rgba(196, 100, 90, .14); }
  .field input:disabled { background: rgba(248, 243, 240, .8); color: #B3A9AE; border-color: rgba(40, 33, 38, .07); }
  .field .helper { font-size: 12px; line-height: 18px; color: var(--eva-text-muted); }
  .error {
    display: flex;
    align-items: flex-start;
    gap: var(--eva-space-2);
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    color: var(--eva-error-ink);
  }
  .error .mark { width: 18px; height: 18px; margin: 0; font-size: 12px; }
  .error--form { margin-top: var(--eva-space-4); font-size: 13px; }

  [hidden] { display: none !important; }
</style>
