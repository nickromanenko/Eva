---
// Layout for the pages an email links to (/activate, /reset). Kept apart from
// Layout.astro on purpose: these pages carry a one-time token in the URL, so
// they make no third-party request (no analytics, no remote font), set no
// cookie, are not indexed, and send no referrer.
//
// Tokens and Montserrat come from styles/tokens.css — the face is self-hosted
// from the app's own OFL files (#85), so it is a first-party request.
import '../styles/tokens.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <a class="logo" href="/"><img src="/assets/eva-logo.png" alt="Eva" /></a>
      <section class="card">
        <slot />
      </section>
    </main>
  </body>
</html>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    background: var(--eva-bg) var(--eva-grad-blush) fixed;
    font-family: var(--eva-font);
    color: var(--eva-text-secondary);
    -webkit-font-smoothing: antialiased;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--eva-space-8);
    padding: var(--eva-space-10) var(--eva-space-4);
  }

  /* The logo asset has an opaque white box; multiply lets the gradient show through it. */
  .logo img { height: 34px; width: auto; display: block; mix-blend-mode: multiply; }

  /* Standard card treatment, DESIGN.md §4. */
  .card {
    width: 100%;
    max-width: 420px;
    padding: var(--eva-space-8) var(--eva-space-6);
    border-radius: var(--eva-radius-card);
    background: var(--eva-card-fill);
    -webkit-backdrop-filter: var(--eva-card-blur);
    backdrop-filter: var(--eva-card-blur);
    border: 1px solid var(--eva-card-border);
    box-shadow: var(--eva-card-shadow);
  }

  /* H1 · screen title, Body, Caption — DESIGN.md §3. Caption takes Secondary Text: muted
     measures under 3:1 on the card, and this caption is informative (the §9a settings-row
     argument, as tokens.css's t-caption). */
  h1 { font-size: 28px; line-height: 34px; font-weight: 600; color: var(--eva-text); }
  h1:focus { outline: none; }
  p { font-size: 15px; line-height: 24px; }
  h1 + p, p + p { margin-top: var(--eva-space-3); }
  .caption { color: var(--eva-text-secondary); font-size: 12.5px; line-height: 19px; }
  .actions + .caption { margin-top: var(--eva-space-4); }

  /* Semantic marks: ✓ circle, ! circle, i circle — the shape carries the state, never the colour alone.
     The glyph must reach 4.5:1 on its own tint over the card. Success and info take their
     §2 ink (5.3:1+). Error's base measures 3.3:1 and even its ink only 4.4:1 there, so the
     "!" takes the §9a ramp's bottom stop (5.1:1+); the tint, border and message stay error. */
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin-bottom: var(--eva-space-4);
    border-radius: 50%;
    border: 1px solid;
    font-size: 20px;
    font-weight: 600;
    line-height: 1;
  }
  .mark--success { color: var(--eva-success-ink); background: var(--eva-success-tint); border-color: var(--eva-success-border); }
  .mark--error { color: var(--eva-action-bottom); background: var(--eva-error-tint); border-color: var(--eva-error-border); }
  .mark--info { color: var(--eva-info-ink); background: var(--eva-info-tint); border-color: var(--eva-info-border); font-family: Georgia, serif; font-style: italic; }
  .mark--pending { color: var(--eva-text-muted); border-color: var(--eva-control-border); }

  .actions { display: flex; flex-direction: column; gap: var(--eva-space-2); margin-top: var(--eva-space-6); }

  /* Primary button — DESIGN.md §5, on the §9a action ramp: white on the canvas pink
     measures 3.84:1. Disabled takes Primary Text, also §9a. */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--eva-control-height);
    padding: 0 var(--eva-space-6);
    border: 0;
    border-radius: var(--eva-radius-control);
    background: var(--eva-grad-action);
    color: var(--eva-text-on-dark);
    font: inherit;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--eva-shadow-action);
    transition: transform .12s ease, background .12s ease;
  }
  .btn-primary:active { background: var(--eva-grad-action-pressed); transform: scale(.97); }
  .btn-primary:focus-visible { outline: var(--eva-focus-ring) solid var(--eva-focus); outline-offset: 2px; }
  .btn-primary:disabled { background: var(--eva-primary-disabled); color: var(--eva-text); box-shadow: none; cursor: default; transform: none; }

  /* Text button — DESIGN.md §5; §9a ink. */
  .btn-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: var(--eva-radius-text);
    background: transparent;
    color: var(--eva-action-top);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-text:focus-visible { outline: var(--eva-focus-ring) solid var(--eva-focus); outline-offset: 2px; }

  /* Input, label, helper, error — DESIGN.md §3 and §6. */
  .field { display: flex; flex-direction: column; gap: var(--eva-space-2); margin-top: var(--eva-space-4); }
  .field label { font-size: 12px; font-weight: 600; color: var(--eva-text-secondary); }
  .field input {
    height: var(--eva-control-height);
    padding: 0 15px;
    border-radius: var(--eva-radius-control);
    border: 1px solid var(--eva-control-border);
    background: var(--eva-input-fill);
    color: var(--eva-text);
    font: inherit;
    font-size: 15px;
    outline: none;
  }
  .field input:focus { background: var(--eva-opaque); border-color: var(--eva-deep-pink); box-shadow: 0 0 0 var(--eva-focus-ring) var(--eva-input-focus-ring); }
  .field input[aria-invalid="true"] { background: var(--eva-input-error-fill); border-color: var(--eva-error); box-shadow: 0 0 0 var(--eva-focus-ring) var(--eva-input-error-ring); }
  .field input:disabled { background: var(--eva-input-disabled-fill); color: var(--eva-disabled-text); border-color: var(--eva-input-disabled-border); }
  .field .helper { font-size: 12px; line-height: 18px; color: var(--eva-text-secondary); }
  .error {
    display: flex;
    align-items: flex-start;
    gap: var(--eva-space-2);
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    color: var(--eva-error-ink);
  }
  .error .mark { width: 18px; height: 18px; margin: 0; font-size: 12px; }
  .error--form { margin-top: var(--eva-space-4); font-size: 13px; }

  [hidden] { display: none !important; }
</style>
