---
// Shared layout for secondary pages (privacy, terms, transparency): the landing page's
// nav and footer, and the long-form text on an L3 surface (DESIGN.md §4 — "long-form
// content"). Every value comes from styles/tokens.css.
import '../styles/tokens.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/"><img src="/assets/eva-logo.png" alt="Eva" /></a>
        <a class="cta" href="/#download">Get the app</a>
      </nav>
    </header>
    <main>
      <article class="sheet">
        <slot />
      </article>
    </main>
    <footer>
      <span>© 2026 Eva. All rights reserved.</span>
      <span><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Use</a></span>
    </footer>
  </body>
</html>

<style is:global>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    min-height:100vh; display:flex; flex-direction:column;
    background:var(--eva-bg) var(--eva-grad-blush) fixed;
    font-family:var(--eva-font); color:var(--eva-text-secondary);
    -webkit-font-smoothing:antialiased;
  }
  a { color:var(--eva-action-top); text-decoration:underline; text-underline-offset:2px; }
  a:hover { color:var(--eva-action-bottom); }
  a:focus-visible { outline:var(--eva-focus-ring) solid var(--eva-focus); outline-offset:2px; border-radius:4px; }
  ::selection { background:var(--eva-blush); color:var(--eva-text); }

  /* §3: H1 screen title, H2 section heading, Body. */
  main h1 { font-size:28px; line-height:34px; font-weight:600; color:var(--eva-text); }
  main h2 { font-size:21px; line-height:26px; font-weight:600; color:var(--eva-text); margin-top:var(--eva-space-10); }
  main p, main li { font-size:15px; line-height:24px; }
  main p { margin-top:var(--eva-space-3); }
  main strong { font-weight:600; color:var(--eva-text); }
  main ul { margin-top:var(--eva-space-3); padding-left:var(--eva-space-6); }
  main li + li { margin-top:var(--eva-space-2); }
  main li::marker { color:var(--eva-deep-pink); }

  /* §2 Warning: tint, border, ink, and the "! rounded square" mark — never colour alone. */
  /* The mark is positioned rather than a flex item: the banner's text is a <strong> and a
     bare text node, and flex would split them into columns. */
  .banner {
    position:relative;
    margin-bottom:var(--eva-space-6);
    padding:var(--eva-space-3) var(--eva-space-4) var(--eva-space-3) calc(var(--eva-space-4) + 20px + var(--eva-space-3));
    border-radius:var(--eva-radius-control); border:1px solid;
    font-size:15px; line-height:24px;
  }
  .banner::before {
    position:absolute; left:var(--eva-space-4); top:calc(var(--eva-space-3) + 2px);
    display:grid; place-items:center;
    width:20px; height:20px; border-radius:6px;
    content:"!"; font-size:12px; font-weight:600; line-height:1;
  }
  .banner strong { color:inherit; }
  .banner--warning { background:var(--eva-warning-tint); border-color:var(--eva-warning-border); color:var(--eva-warning-ink); }
  .banner--warning::before { background:var(--eva-warning-ink); color:var(--eva-text-on-dark); }
</style>

<style>
  header {
    position:sticky; top:0; z-index:50;
    background:var(--eva-bar); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px);
    border-bottom:1px solid var(--eva-control-border);
  }
  nav {
    max-width:1200px; margin:0 auto; padding:var(--eva-space-3) var(--eva-space-8);
    display:flex; align-items:center; justify-content:space-between; gap:var(--eva-space-6);
  }
  nav img { height:34px; width:auto; display:block; }
  /* §5 primary on the §9a action ramp, at the §1 touch floor rather than 52 — it sits in a bar. */
  nav .cta {
    display:inline-flex; align-items:center; min-height:var(--eva-touch);
    padding:0 var(--eva-space-6); border-radius:var(--eva-radius-control);
    background:var(--eva-grad-action); color:var(--eva-text-on-dark);
    font-size:14.5px; font-weight:600; text-decoration:none; white-space:nowrap;
    box-shadow:var(--eva-shadow-action);
  }
  nav .cta:hover { color:var(--eva-text-on-dark); background:var(--eva-grad-action-pressed); }
  main { flex:1; width:100%; max-width:820px; margin:0 auto; padding:var(--eva-space-10) var(--eva-space-4) calc(var(--eva-space-10) * 2); }
  .sheet {
    padding:var(--eva-space-10) var(--eva-space-8);
    border-radius:var(--eva-radius-card);
    background:var(--eva-glass-l3);
    -webkit-backdrop-filter:blur(28px); backdrop-filter:blur(28px);
    border:1px solid var(--eva-card-border);
    box-shadow:var(--eva-card-shadow);
  }
  footer {
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:var(--eva-space-3);
    padding:var(--eva-space-6) var(--eva-space-8);
    background:var(--eva-bg-secondary); border-top:1px solid var(--eva-control-border);
    color:var(--eva-text-secondary); font-size:12.5px; line-height:19px;
  }
  footer a { color:var(--eva-text-secondary); }
  footer a:hover { color:var(--eva-text); }
  @media (max-width:640px) {
    nav { padding:var(--eva-space-3) var(--eva-space-4); }
    .sheet { padding:var(--eva-space-8) var(--eva-space-6); }
    footer { padding:var(--eva-space-6) var(--eva-space-4); }
  }
</style>
