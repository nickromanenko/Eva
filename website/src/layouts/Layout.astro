---
// Shared layout for secondary pages (privacy, terms), styled to match the
// landing page design: same fonts, palette, nav and footer treatment.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/"><img src="/assets/eva-logo.png" alt="Eva" /></a>
        <a class="cta" href="/#download">Get the app</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© 2026 Eva. All rights reserved.</span>
      <span><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Use</a></span>
    </footer>
  </body>
</html>

<style is:global>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:#FBF8FB; font-family:'Hanken Grotesk',system-ui,sans-serif; color:#6E5E69; -webkit-font-smoothing:antialiased; min-height:100vh; display:flex; flex-direction:column; }
  a { color:#8E2C57; text-decoration:none; }
  a:hover { color:#C96A93; }
  ::selection { background:#E9C4D6; color:#3A2233; }
  h1 { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:44px; line-height:1.1; color:#3A2233; }
  main h2 { font-family:'Cormorant Garamond',serif; font-weight:600; font-size:28px; color:#3A2233; margin-top:36px; }
  main p { font-size:16px; line-height:1.7; margin-top:14px; }
</style>

<style>
  header { position:sticky; top:0; z-index:50; background:rgba(251,248,251,.82); backdrop-filter:blur(14px); border-bottom:1px solid #EFE6ED; }
  nav { max-width:1200px; margin:0 auto; padding:16px 32px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  nav img { height:34px; width:auto; display:block; }
  nav .cta { background:linear-gradient(135deg,#8E2C57,#C96A93); color:#fff; padding:11px 22px; border-radius:999px; font-size:15px; font-weight:600; box-shadow:0 8px 20px -8px rgba(142,44,87,.6); }
  main { flex:1; max-width:820px; width:100%; margin:0 auto; padding:64px 32px 92px; }
  footer { background:#2B1A26; color:#8C7683; font-size:13.5px; }
  footer { display:flex; justify-content:space-between; flex-wrap:wrap; gap:14px; padding:24px 32px; }
  footer a { color:#C9B7C2; }
</style>
