  .cal { margin-top:var(--eva-space-4); display:grid; grid-template-columns:repeat(7, 1fr); gap:var(--eva-space-2); text-align:center; }
  .cal-dow { color:var(--eva-text-secondary); }
  .day { aspect-ratio:1; display:grid; place-items:center; border-radius:var(--eva-radius-chip); background:var(--eva-opaque); color:var(--eva-text-secondary); }
  /* Period is §2 Primary Pink as a wash, so the number stays Primary Text; the marked day
     takes the §9a solid because it carries a white label. */
  .day--period { background:var(--eva-pink); color:var(--eva-text); }
  .day--ovulation { background:var(--eva-action-solid); color:var(--eva-text-on-dark); box-shadow:var(--eva-shadow-action); }
  .day--training { background:var(--eva-pistachio); color:var(--eva-text); }
  .legend { margin-top:var(--eva-space-4); display:flex; flex-wrap:wrap; gap:var(--eva-space-4); color:var(--eva-text-secondary); }
  .legend > span { display:flex; align-items:center; gap:var(--eva-space-2); }
  .swatch { width:10px; height:10px; border-radius:3px; box-shadow:none; }

  .kcal { margin-top:var(--eva-space-2); }
  .kcal-unit { color:var(--eva-text-secondary); }
  .bars { margin-top:var(--eva-space-4); display:flex; flex-direction:column; gap:var(--eva-space-3); }
  .bar-label { display:flex; justify-content:space-between; margin-bottom:var(--eva-space-1); color:var(--eva-text-secondary); }
  .bar { height:8px; border-radius:var(--eva-radius-pill); background:var(--eva-bg-secondary); }
  .inner--session .bar { margin-top:var(--eva-space-3); }
  .bar-fill { height:100%; border-radius:var(--eva-radius-pill); }
  .bar-fill--action { background:var(--eva-action-top); }
  .bar-fill--pink { background:var(--eva-pink); }
  .bar-fill--pistachio { background:var(--eva-deep-pistachio); }

  .pill { padding:var(--eva-space-1) var(--eva-space-2); border-radius:var(--eva-radius-chip); border:1px solid transparent; white-space:nowrap; }
  .pill--pistachio { background:var(--eva-light-pistachio); color:var(--eva-text); }
  .pill--success { background:var(--eva-success-tint); border-color:var(--eva-success-border); color:var(--eva-success-ink); }
  .pill--action { background:var(--eva-grad-action); color:var(--eva-text-on-dark); }
  .pill--quiet { background:var(--eva-bg-secondary); color:var(--eva-text-secondary); }

  .session { display:flex; align-items:center; gap:var(--eva-space-3); padding:var(--eva-space-4); border-radius:var(--eva-radius-control); background:var(--eva-glass-elevated); border:1px solid transparent; }
  /* §6 radio row, selected. */
  .session--selected { background:var(--eva-selected-fill); border-color:var(--eva-selected-border); }
  .session-text { flex:1; }
  .session-tile { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:var(--eva-radius-chip); }
  .session-tile--solid { background:var(--eva-action-solid); color:var(--eva-text-on-dark); }
  .session-tile--action { background:var(--eva-grad-action); color:var(--eva-text-on-dark); }
  .session-tile--pistachio { background:var(--eva-pistachio); color:var(--eva-text); }

  /* §6 five-point scale: the selected cell raised, opaque and outlined; the rest at 72%. */
  .moods { margin-top:var(--eva-space-4); display:flex; justify-content:space-between; gap:var(--eva-space-2); }
  .mood { flex:1; aspect-ratio:1; display:grid; place-items:center; border-radius:var(--eva-radius-chip); background:var(--eva-glass-elevated); opacity:.72; }
  .mood--selected { opacity:1; background:var(--eva-opaque); outline:2px solid var(--eva-action-top); box-shadow:var(--eva-card-shadow); }

  /* MISSION — §2 pink→pistachio. */
  .mission { background:var(--eva-grad-pink-pistachio); text-align:center; }
  .mission-quote { margin-top:var(--eva-space-6); text-wrap:balance; }
  .mission-body { margin:var(--eva-space-6) auto var(--eva-space-8); max-width:640px; color:var(--eva-text); }

  /* BLOG */
  .blog-head { display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:var(--eva-space-6); margin-bottom:var(--eva-space-10); }
  .blog-head-copy { max-width:560px; }
  .blog-head-copy h2 { margin-top:var(--eva-space-3); color:var(--eva-text); }
  .blog-head-copy .t-body { margin-top:var(--eva-space-3); }
  .post { overflow:hidden; }
  /* The §2 washes stand in for the editorial image, as on Home's rail (§9a, #102). */
  .cover { position:relative; height:160px; }
  .cover--blush { background:var(--eva-grad-blush); }
  .cover--pistachio { background:var(--eva-grad-pistachio); }
  .cover-tag { position:absolute; bottom:var(--eva-space-4); left:var(--eva-space-4); padding:var(--eva-space-1) var(--eva-space-3); border-radius:var(--eva-radius-chip); background:var(--eva-glass-elevated); color:var(--eva-text); }
  .post-body { padding:var(--eva-space-6); }
  .post-body h3 { color:var(--eva-text); }
  .post-body .t-body { margin-top:var(--eva-space-2); }
  .post-meta { margin-top:var(--eva-space-3); }

  /* TESTIMONIALS */
  .quote { padding:var(--eva-space-8); }
  /* The ramp's bottom stop: the top stop measures ~4.5:1 on the card over the band. */
  .stars { color:var(--eva-action-bottom); letter-spacing:.1em; }
  .quote > .t-body { margin-top:var(--eva-space-4); }
  .quote-by { margin-top:var(--eva-space-6); display:flex; align-items:center; gap:var(--eva-space-3); }

  /* FAQ */
  .faq { display:flex; flex-direction:column; gap:var(--eva-space-3); }
  .faq-item { padding:0 var(--eva-space-6); }
  .faq-item summary { display:flex; justify-content:space-between; align-items:center; gap:var(--eva-space-4); min-height:var(--eva-touch); padding:var(--eva-space-6) 0; color:var(--eva-text); }
  .faq-plus { color:var(--eva-action-top); transition:transform .25s; line-height:1; font-weight:400; }
  .faq-item > .t-body { padding-bottom:var(--eva-space-6); }

  /* DOWNLOAD CTA */
  .cta-section { padding-bottom:calc(var(--eva-space-10) * 2); }
  .cta-block {
    padding:calc(var(--eva-space-10) * 2) var(--eva-space-10);
    border-radius:var(--eva-radius-sheet); text-align:center;
    background:var(--eva-grad-action); color:var(--eva-text-on-dark);
    box-shadow:var(--eva-shadow-action);
  }
  .cta-block h2 { text-wrap:balance; }
  .cta-block > .t-body { margin:var(--eva-space-4) auto 0; max-width:520px; }
  .cta-note { margin-top:var(--eva-space-6); }

  /* FOOTER — no dark palette is designed (DESIGN.md §10), so the footer sits on Secondary Background. */
  .site-footer { background:var(--eva-bg-secondary); border-top:1px solid var(--eva-control-border); }
  .footer-inner { padding-top:calc(var(--eva-space-10) + var(--eva-space-6)); padding-bottom:var(--eva-space-10); }
  .footer-grid { display:grid; grid-template-columns:1.4fr 1fr 1fr 1fr; gap:var(--eva-space-10); }
  .wordmark { color:var(--eva-action-top); }
  .footer-tagline { margin-top:var(--eva-space-3); max-width:280px; }
  .footer-links { margin-top:var(--eva-space-4); display:flex; flex-direction:column; gap:var(--eva-space-2); }
  .footer-links a { color:var(--eva-text-secondary); }
  .footer-links a:hover { color:var(--eva-text); }
  .footer-bottom { margin-top:var(--eva-space-10); padding-top:var(--eva-space-6); border-top:1px solid var(--eva-control-border); display:flex; justify-content:space-between; flex-wrap:wrap; gap:var(--eva-space-3); }

  @media (max-width: 960px) {
    .hero-grid, .split, .grid--3 { grid-template-columns:1fr; }
    .grid--4, .footer-grid { grid-template-columns:repeat(2, 1fr); }
    .split { gap:var(--eva-space-8); }
    .split--reverse .split-copy { order:0; }
  }
  @media (max-width: 640px) {
    .wrap, .split { padding-left:var(--eva-space-4); padding-right:var(--eva-space-4); }
    .nav-links { display:none; }
    .hero-grid { padding-top:var(--eva-space-10); padding-bottom:calc(var(--eva-space-10) + var(--eva-space-6)); }
    .section { padding-top:calc(var(--eva-space-10) + var(--eva-space-6)); padding-bottom:calc(var(--eva-space-10) + var(--eva-space-6)); }
    .grid--4, .footer-grid { grid-template-columns:1fr; }
    .cta-block { padding:var(--eva-space-10) var(--eva-space-6); }
    .mock { padding:var(--eva-space-6); }
    .feature, .quote { padding:var(--eva-space-6); }
  }
</style>

</body>
</html>
