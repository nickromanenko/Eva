---
// Landing page. The structure and copy come from the Claude Design mockup "Eva Landing
// Page"; the look is docs/DESIGN.md's (#85) — there is no website canvas, so the tokens
// are the spec. Every value is a custom property from styles/tokens.css; type is set by
// the §3 role classes (t-display, t-h1 …) rather than by size.
import '../styles/tokens.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="generator" content={Astro.generator} />
  <title>Eva — the first AI made for women</title>
  <meta name="description" content="Eva is the first AI assistant built around a woman's physiology — your cycle, energy, and goals. Enter your Prime Era on your own terms." />
</head>
<body>

<div class="page">

  <!-- NAV -->
  <header class="site-header">
    <nav class="nav wrap">
      <a href="/" class="logo"><img src="/assets/eva-logo.png" alt="Eva" /></a>
      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#features">Features</a>
        <a href="#science">Science</a>
        <a href="#mission">Mission</a>
        <a href="#faq">FAQ</a>
      </div>
      <a href="#download" class="btn-primary btn-primary--bar">Get the app</a>
    </nav>
  </header>

  <main>

  <!-- HERO -->
  <section class="hero">
    <div class="blob blob--blush" aria-hidden="true"></div>
    <div class="blob blob--pistachio" aria-hidden="true"></div>
    <div class="hero-grid wrap">
      <div>
        <span class="tag t-control">
          <span class="tag-dot"></span>Meet Eva — your AI health companion
        </span>
        <h1 class="t-display hero-title">Enter your <span class="accent">Prime Era</span>, on your own terms.</h1>
        <p class="t-body lead">Eva is the first AI assistant built around a woman's physiology — your cycle, energy, and goals. Stop fighting your body. Start working <em>with</em> it.</p>

        <div class="store-row">
          <a href="#download" class="store-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 12.6c0-2 1.6-3 1.7-3.1-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7c-1.3 0-2.6.8-3.3 2-1.4 2.4-.4 6 1 8 .7 1 1.4 2 2.5 2s1.4-.6 2.6-.6 1.5.6 2.6.6 1.8-1 2.4-2c.8-1.1 1.1-2.2 1.1-2.3-.1 0-2.1-.8-2.1-3.1zM14.6 6.2c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 2-.5 2.5-1.2z"/></svg>
            <span class="store-text"><span class="t-caption">Download on the</span><span class="t-h3">App Store</span></span>
          </a>
        </div>

        <div class="social">
          <div class="avatars">
            <span class="avatar avatar--pink t-control">M</span>
            <span class="avatar avatar--pistachio t-control">S</span>
            <span class="avatar avatar--blush t-control">A</span>
            <span class="avatar avatar--pink t-label">+9k</span>
          </div>
          <p class="t-body"><strong>Joined by 12,000+ women</strong><br />building their Glow Up with Eva.</p>
        </div>
      </div>

      <!-- PHONE MOCKUP -->
      <div class="phone-stage">
        <div class="phone">
          <div class="screen">
            <!-- status bar -->
            <div class="status t-label">
              <span>9:41</span>
              <span class="notch"></span>
              <span class="status-icons">
                <svg width="17" height="11" viewBox="0 0 17 11" fill="currentColor"><rect x="0" y="7" width="3" height="4" rx="1"/><rect x="4" y="5" width="3" height="6" rx="1"/><rect x="8" y="3" width="3" height="8" rx="1"/><rect x="12" y="1" width="3" height="10" rx="1"/></svg>
                <svg width="18" height="11" viewBox="0 0 18 11" fill="none"><rect x="1" y="1" width="14" height="9" rx="2.5" stroke="currentColor" stroke-width="1.2"/><rect x="2.6" y="2.6" width="9" height="5.8" rx="1.2" fill="currentColor"/><rect x="16" y="4" width="1.6" height="3.5" rx=".8" fill="currentColor"/></svg>
              </span>
            </div>

            <!-- app content -->
            <div class="app">
              <div class="app-head">
                <div>
                  <p class="t-caption">Good morning,</p>
                  <p class="t-h2 ink">Maya</p>
                </div>
                <span class="avatar avatar--pink avatar--lg t-control">M</span>
              </div>

              <!-- cycle card -->
              <div class="cycle-card">
                <div class="ring">
                  <svg width="78" height="78" viewBox="0 0 78 78">
                    <circle cx="39" cy="39" r="32" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="7"/>
                    <circle cx="39" cy="39" r="32" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-dasharray="201" stroke-dashoffset="90"/>
                  </svg>
                  <div class="ring-label">
                    <div><div class="t-h2">14</div><div class="t-overline">DAY</div></div>
                  </div>
                </div>
                <div>
                  <p class="t-h3">Ovulation phase</p>
                  <p class="t-caption">Peak energy — a great day for a strength session.</p>
                </div>
              </div>

              <!-- shortcuts -->
              <div class="shortcuts">
                <div class="shortcut shortcut--blush">
                  <span class="shortcut-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4.5" width="18" height="17" rx="3"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg></span>
                  <span class="t-label">Cycle</span>
                </div>
                <div class="shortcut shortcut--pistachio">
                  <span class="shortcut-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21c5-3 8-7 8-11a5 5 0 0 0-8-4 5 5 0 0 0-8 4c0 4 3 8 8 11z"/></svg></span>
                  <span class="t-label">Nutrition</span>
                </div>
                <div class="shortcut shortcut--blush">
                  <span class="shortcut-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6.5 6.5 4 9m2.5-2.5L9 4M17.5 17.5 20 15m-2.5 2.5L15 20m-8-3 10-10"/></svg></span>
                  <span class="t-label">Trainer</span>
                </div>
                <div class="shortcut shortcut--pistachio">
                  <span class="shortcut-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0-6 6c0 2 1 3 1 5h10c0-2 1-3 1-5a6 6 0 0 0-6-6zM9 20h6M10 22h4"/></svg></span>
                  <span class="t-label">Mind</span>
                </div>
              </div>

              <!-- chat -->
              <div class="chat">
                <div class="chat-row">
                  <span class="avatar avatar--pink avatar--sm t-label">E</span>
                  <p class="t-caption bubble">Your iron looks a little low this week. Want a menu that helps?</p>
                </div>
                <div class="chat-input">
                  <span class="t-caption">Ask Eva anything…</span>
                  <span class="send"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5 21 12 3 3.5 6 12l-3 8.5z"/></svg></span>
                </div>
              </div>
            </div>

            <!-- tab bar -->
            <div class="tabbar">
              <svg class="tab tab--active" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3 3 10v10h6v-6h6v6h6V10z"/></svg>
              <svg class="tab" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4.5" width="18" height="17" rx="3"/><path d="M3 9h18"/></svg>
              <svg class="tab" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V9l8-5 8 5v10M9 19v-6h6v6"/></svg>
              <svg class="tab" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LOGO STRIP / VALUES -->
  <section class="strip">
    <div class="strip-inner wrap">
      <span class="t-overline">Designed around her, not the default</span>
      <div class="strip-items t-body-medium">
        <span class="check-item"><svg class="check" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Hormone-aware</span>
        <span class="check-item"><svg class="check" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Science-backed</span>
        <span class="check-item"><svg class="check" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Private by design</span>
        <span class="check-item"><svg class="check" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Made with women</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM / INVISIBLE WOMEN -->
  <section id="science" class="section wrap">
    <div class="section-head">
      <span class="t-overline">The invisible gap</span>
      <h2 class="t-h1">For decades, the world was built for the male body.</h2>
      <p class="t-body">In <em>Invisible Women</em>, Caroline Criado Perez documents how a data gap left women's needs an afterthought — in medicine, safety, and technology.</p>
    </div>

    <div class="grid grid--4">
      <div class="card stat">
        <p class="t-display stat-figure">5°C</p>
        <p class="t-body">Standard office temperatures can run ~5°C colder than what's comfortable for women.</p>
      </div>
      <div class="card stat">
        <p class="t-display stat-figure">47%</p>
        <p class="t-body">More likely to be seriously injured in comparable crashes — female dummies arrived only in 2011.</p>
      </div>
      <div class="card stat">
        <p class="t-display stat-figure">70%</p>
        <p class="t-body">Speech recognition was up to 70% more accurate at understanding male voices.</p>
      </div>
      <div class="card stat stat--brand">
        <p class="t-display stat-figure">Eva</p>
        <p class="t-body">Closes the gap on a personal level — an assistant that finally accounts for <em>you</em>.</p>
      </div>
    </div>
  </section>

  <!-- HOW / FEATURES GRID -->
  <section id="features" class="band">
    <div class="section wrap">
      <div class="section-head">
        <span class="t-overline">One companion, every day</span>
        <h2 class="t-h1">Everything Eva does for you</h2>
        <p class="t-body">Eva reads your physiology, hormonal cycle, emotional state, habits and goals — then guides your day with them, not against them.</p>
      </div>

      <div id="how" class="grid grid--3">
        <div class="card feature">
          <div class="icon-tile icon-tile--blush"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4.5" width="18" height="17" rx="3"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg></div>
          <h3 class="t-h3">Cycle-aware calendar</h3>
          <p class="t-body">Track your cycle, sex life and training in one view — and see how each phase shapes your energy.</p>
        </div>
        <div class="card feature">
          <div class="icon-tile icon-tile--pistachio"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21c5-3 8-7 8-11a5 5 0 0 0-8-4 5 5 0 0 0-8 4c0 4 3 8 8 11z"/></svg></div>
          <h3 class="t-h3">Nutrition adviser</h3>
          <p class="t-body">Calorie and nutrient guidance tuned to your goals, preferences, deficiencies and cycle phase.</p>
        </div>
        <div class="card feature">
          <div class="icon-tile icon-tile--blush"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6.5 6.5 4 9m2.5-2.5L9 4M17.5 17.5 20 15m-2.5 2.5L15 20m-8-3 10-10"/></svg></div>
          <h3 class="t-h3">Personal trainer</h3>
          <p class="t-body">A training program built for your frequency and goals — with the principles of training for women.</p>
        </div>
        <div class="card feature">
          <div class="icon-tile icon-tile--pistachio"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0-6 6c0 2 1 3 1 5h10c0-2 1-3 1-5a6 6 0 0 0-6-6zM9 20h6M10 22h4"/></svg></div>
          <h3 class="t-h3">Mental well-being coach</h3>
          <p class="t-body">Coaching to handle stress, sharpen concentration, and get genuinely restful sleep.</p>
        </div>
        <div class="card feature">
          <div class="icon-tile icon-tile--blush"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
          <h3 class="t-h3">Smart dashboard & chat</h3>
          <p class="t-body">Shortcuts, daily tips and a chat that knows your context — ask Eva anything, anytime.</p>
        </div>
        <div class="card feature">
          <div class="icon-tile icon-tile--pistachio"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M8 9h6M8 13h8M8 17h5"/></svg></div>
          <h3 class="t-h3">Science-backed blog</h3>
          <p class="t-body">Every recommendation links back to the research behind it. The science stays transparent.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE DEEP DIVE 1: Calendar -->
  <section class="split split--first">
    <div class="split-copy">
      <span class="t-overline">Calendar</span>
      <h3 class="t-h2">Your whole rhythm, in one place</h3>
      <p class="t-body">Log your cycle, intimacy and workouts together. Eva overlays them so you can finally see the patterns — and plan around the days you feel your best.</p>
      <ul class="checklist t-body">
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Cycle, sex-life & training tracking</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Phase-based energy forecasts</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Gentle, private reminders</li>
      </ul>
    </div>
    <div class="mock mock--blush">
      <p class="t-overline ink">October</p>
      <div class="cal">
        <span class="cal-dow t-label">M</span><span class="cal-dow t-label">T</span><span class="cal-dow t-label">W</span><span class="cal-dow t-label">T</span><span class="cal-dow t-label">F</span><span class="cal-dow t-label">S</span><span class="cal-dow t-label">S</span>
        <span class="day t-control">7</span>
        <span class="day day--period t-control">8</span>
        <span class="day day--period t-control">9</span>
        <span class="day t-control">10</span>
        <span class="day t-control">11</span>
        <span class="day day--training t-control">12</span>
        <span class="day t-control">13</span>
        <span class="day day--ovulation t-control">14</span>
        <span class="day t-control">15</span>
        <span class="day day--training t-control">16</span>
        <span class="day t-control">17</span>
        <span class="day t-control">18</span>
        <span class="day t-control">19</span>
        <span class="day t-control">20</span>
      </div>
      <div class="legend t-label">
        <span><span class="swatch day--period"></span>Period</span>
        <span><span class="swatch day--ovulation"></span>Ovulation</span>
        <span><span class="swatch day--training"></span>Training</span>
      </div>
    </div>
  </section>

  <!-- FEATURE DEEP DIVE 2: Nutrition (reversed) -->
  <section class="split split--reverse">
    <div class="split-copy">
      <span class="t-overline">Nutrition adviser</span>
      <h3 class="t-h2">Fuel that fits your phase</h3>
      <p class="t-body">Tell Eva your goals, preferences and deficiencies. She calculates what your body needs for the activity ahead and the phase you're in — no more generic meal plans.</p>
      <ul class="checklist t-body">
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Cycle- & activity-aware calories</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Deficiency-aware suggestions</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Respects your food preferences</li>
      </ul>
    </div>
    <div class="mock mock--pistachio">
      <div class="inner">
        <div class="inner-head">
          <p class="t-h3 ink">Today's target</p>
          <span class="pill pill--pistachio t-label">Ovulation</span>
        </div>
        <p class="t-display ink kcal">2,080 <span class="t-body kcal-unit">kcal</span></p>
        <div class="bars">
          <div><div class="bar-label t-caption"><span>Protein</span><span>128 g</span></div><div class="bar"><div class="bar-fill bar-fill--action" style="width:78%;"></div></div></div>
          <div><div class="bar-label t-caption"><span>Iron</span><span>Focus today</span></div><div class="bar"><div class="bar-fill bar-fill--pink" style="width:46%;"></div></div></div>
          <div><div class="bar-label t-caption"><span>Hydration</span><span>2.1 L</span></div><div class="bar"><div class="bar-fill bar-fill--pistachio" style="width:64%;"></div></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE DEEP DIVE 3: Trainer -->
  <section class="split">
    <div class="split-copy">
      <span class="t-overline">Personal trainer</span>
      <h3 class="t-h2">Train with your body's clock</h3>
      <p class="t-body">Eva builds a program around your goals and how often you want to move — then explains the principles behind training designed for women, so every session has a reason.</p>
      <ul class="checklist t-body">
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Adaptive weekly programming</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Recovery matched to your phase</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>The 'why' behind every workout</li>
      </ul>
    </div>
    <div class="mock mock--blush mock--stack">
      <div class="session">
        <span class="session-tile session-tile--solid t-h3">M</span>
        <div class="session-text"><p class="t-body-medium ink">Mon · Strength</p><p class="t-caption">Lower body · 45 min</p></div>
        <span class="pill pill--success t-label">Done</span>
      </div>
      <div class="session session--selected">
        <span class="session-tile session-tile--action t-h3">W</span>
        <div class="session-text"><p class="t-body-medium ink">Wed · Power</p><p class="t-caption">Peak energy — go heavy</p></div>
        <span class="pill pill--action t-label">Today</span>
      </div>
      <div class="session">
        <span class="session-tile session-tile--pistachio t-h3">F</span>
        <div class="session-text"><p class="t-body-medium ink">Fri · Mobility</p><p class="t-caption">Gentle flow · 25 min</p></div>
        <span class="pill pill--quiet t-label">Planned</span>
      </div>
    </div>
  </section>

  <!-- FEATURE DEEP DIVE 4: Mental (reversed) -->
  <section class="split split--reverse split--last">
    <div class="split-copy">
      <span class="t-overline">Mental well-being coach</span>
      <h3 class="t-h2">A calmer, clearer mind</h3>
      <p class="t-body">A personal coaching program to help you handle stress, improve focus and rest well — with check-ins that adapt to how you're actually feeling.</p>
      <ul class="checklist t-body">
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Guided stress & focus sessions</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Sleep & recovery support</li>
        <li><svg class="check" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>Mood check-ins that learn</li>
      </ul>
    </div>
    <div class="mock mock--pistachio">
      <p class="t-overline ink">How are you today?</p>
      <div class="moods">
        <span class="mood t-h2">😔</span>
        <span class="mood t-h2">😐</span>
        <span class="mood mood--selected t-h2">🙂</span>
        <span class="mood t-h2">😄</span>
      </div>
      <div class="inner inner--session">
        <p class="t-h3 ink">Today's session</p>
        <p class="t-body">A 6-minute breathing reset for the afternoon dip.</p>
        <div class="bar"><div class="bar-fill bar-fill--pistachio" style="width:40%;"></div></div>
      </div>
    </div>
  </section>

  <!-- MISSION -->
  <section id="mission" class="mission">
    <div class="section wrap wrap--narrow">
      <span class="t-overline">Our mission</span>
      <p class="t-h1 ink mission-quote">"Instead of fighting their bodies, women learn to understand their unique needs — and use them to their advantage."</p>
      <p class="t-body mission-body">Eva exists to help every woman achieve her Glow Up, build a more comfortable life, and enter her Prime Era on her own terms.</p>
      <a href="#download" class="btn-primary">Begin your Prime Era</a>
    </div>
  </section>

  <!-- BLOG / SCIENCE -->
  <section class="section wrap">
    <div class="blog-head">
      <div class="blog-head-copy">
        <span class="t-overline">Rooted in science</span>
        <h2 class="t-h1">Every recommendation, traceable to research</h2>
