---
// The page an activation email links to. Since #120 it is where the account is
// *created*: sign-up sends only an address, and the password is chosen here, so
// this form is the moment an Eva account comes into existence.
//
// That is also why it no longer confirms on load. It used to spend the token
// immediately, which put weight on a subtlety — mail-security scanners (Safe
// Links, URL Defense) fetch the emailed URL before the person does, and the only
// thing stopping them burning the link was that they do not run JavaScript.
// A form removes the reliance: a scanner will not fill in a password and submit,
// so the token survives whether or not it runs scripts.
//
// The token still travels in the fragment and is still POSTed in the body — a
// `GET ...?token=` would write a live credential into the API's request log.
//
// The rule is stated up front as the helper and errors sit under the field
// (DESIGN.md §6), matching /reset, which this page is now a sibling of rather
// than a different kind of thing.
import AuthLayout from '../layouts/AuthLayout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? '';
const passwordRule = 'At least 8 characters, including one number.';
---

<AuthLayout title="Choose your password — Eva">
  <div id="activate" data-api-base={apiBase}>
    <div data-state="form">
      <h1 tabindex="-1">Choose your password</h1>
      <p>Your email is confirmed. Pick a password and your account is ready.</p>
      <form novalidate>
        <!-- Password managers pair a new password with a username field; we don't know the
             address here (the token is opaque), so it stays empty and hidden. -->
        <input type="text" name="username" autocomplete="username" hidden tabindex="-1" aria-hidden="true" />
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" aria-describedby="password-helper password-error" />
          <p class="helper" id="password-helper">{passwordRule}</p>
          <p class="error" id="password-error" hidden><span class="mark mark--error" aria-hidden="true">!</span><span data-message></span></p>
        </div>
        <div class="field">
          <label for="repeat">Repeat password</label>
          <input id="repeat" name="repeat" type="password" autocomplete="new-password" autocapitalize="off" spellcheck="false" aria-describedby="repeat-error" />
          <p class="error" id="repeat-error" hidden><span class="mark mark--error" aria-hidden="true">!</span><span data-message></span></p>
        </div>
        <p class="error error--form" id="form-error" hidden><span class="mark mark--error" aria-hidden="true">!</span><span data-message></span></p>
        <div class="actions">
          <button class="btn-primary" type="submit">Create my account</button>
        </div>
      </form>
    </div>

    <div data-state="success" hidden>
      <span class="mark mark--success" aria-hidden="true">✓</span>
      <h1 tabindex="-1">Your account is ready</h1>
      <p>You can go back to Eva and sign in.</p>
      <div class="actions">
        <a class="btn-primary" href="eva://activated">Open Eva</a>
      </div>
      <p class="caption">Opening Eva on your phone? Go back to the app and sign in with the password you just chose.</p>
    </div>

    <div data-state="expired" hidden>
      <span class="mark mark--info" aria-hidden="true">i</span>
      <h1 tabindex="-1">This link has expired</h1>
      <p>Activation links work for 24 hours. Open Eva and tap Resend.</p>
      <div class="actions">
        <a class="btn-primary" href="eva://open">Open Eva</a>
      </div>
    </div>

    <div data-state="invalid" hidden>
      <span class="mark mark--error" aria-hidden="true">!</span>
      <h1 tabindex="-1">This link can't be used</h1>
      <p>It has already been used or isn't valid. Open Eva and tap Resend to get a new one.</p>
      <div class="actions">
        <a class="btn-primary" href="eva://open">Open Eva</a>
      </div>
    </div>

    <div data-state="missing" hidden>
      <span class="mark mark--error" aria-hidden="true">!</span>
      <h1 tabindex="-1">This link is incomplete</h1>
      <p>Open the link from your email again, or open Eva and tap Resend.</p>
      <div class="actions">
        <a class="btn-primary" href="eva://open">Open Eva</a>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { callAuthApi, readTokenAndScrubUrl, showState } from '../scripts/auth-api.js';

  const root = document.getElementById('activate');
  const token = readTokenAndScrubUrl();
  const form = root.querySelector('form');
  const password = root.querySelector('#password');
  const repeat = root.querySelector('#repeat');
  const submit = root.querySelector('button[type="submit"]');

  function setError(input, message) {
    const error = document.getElementById(`${input.id}-error`);
    error.querySelector('[data-message]').textContent = message ?? '';
    error.hidden = !message;
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  function setFormError(message) {
    const error = document.getElementById('form-error');
    error.querySelector('[data-message]').textContent = message ?? '';
    error.hidden = !message;
  }

  function setBusy(busy) {
    submit.disabled = busy;
    submit.textContent = busy ? 'Creating…' : 'Create my account';
    password.disabled = busy;
    repeat.disabled = busy;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    setError(password, null);
    setError(repeat, null);
    setFormError(null);

    if (!password.value) {
      setError(password, 'Enter a password.');
      password.focus();
      return;
    }
    if (repeat.value !== password.value) {
      setError(repeat, 'The passwords don’t match.');
      repeat.focus();
      return;
    }

    setBusy(true);
    let result;
    try {
      // POST, with the token in the body. A `GET ...?token=` would put the raw
      // token into the API's own request log, which is the leak the fragment
      // exists to avoid one layer out.
      result = await callAuthApi(root.dataset.apiBase, '/auth/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password: password.value }),
      });
    } catch {
      setBusy(false);
      // The link is untouched: a request that never landed spent no token, and
      // the rule is checked before the token is consumed either way.
      setFormError('We couldn’t reach Eva. Check your connection and try again.');
      return;
    }
    setBusy(false);

    if (result.ok) showState(root, 'success');
    else if (result.code === 'TOKEN_EXPIRED') showState(root, 'expired');
    else if (result.code === 'INVALID_TOKEN') showState(root, 'invalid');
    else if (result.code === 'WEAK_PASSWORD') {
      setError(password, result.message || 'That password is too weak.');
      password.focus();
    } else {
      setFormError('Something went wrong. Please try again.');
    }
  });

  if (!token) showState(root, 'missing');
</script>
